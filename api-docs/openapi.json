            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productId": { "type": "string" },
                "quantity": { "type": "number", "example": 2 }
              },
              "required": ["productId", "quantity"]
            }
          }
        },
        "required": ["customerName", "customerPhone", "deliveryArea", "deliveryAddress", "paymentMethod", "items"]
      },
      "Order": {
        "type": "object",
