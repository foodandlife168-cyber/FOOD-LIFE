          "isActive": { "type": "boolean", "example": true }
        },
        "required": ["id", "nameEn", "category", "unit", "sellingPrice"]
      },
      "CreateOrderRequest": {
        "type": "object",
        "properties": {
          "customerName": { "type": "string", "example": "Kamal Wickramasinghe" },
          "customerPhone": { "type": "string", "example": "+94 77 123 4567" },
          "deliveryArea": { "type": "string", "example": "Katuloya" },
